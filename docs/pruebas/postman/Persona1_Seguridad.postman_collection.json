{
  "info": {
    "name": "Persona 1 - Seguridad (USR2, USR3, USR4, USR5, GEN1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Verificada en Postman Runner local el 5 de octubre de 2026 contra PrograV: 43 solicitudes, 56 comprobaciones aprobadas, cero fallos, errores y omisiones. Evidencias en docs/pruebas/RESUMEN_PERSONA2.md. Usar el entorno Persona1_Persona2.local, completar credenciales localmente y seguir README_PERSONA1_PERSONA2.md. Crea datos ficticios exclusivos de cada ejecución; ejecutar limpieza al finalizar."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "p1Run",
      "value": ""
    },
    {
      "key": "parametroPrueba",
      "value": ""
    },
    {
      "key": "bitacoraId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · USR5 - Autenticación",
      "item": [
        {
          "name": "Login válido y guardar tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "usuario",
                "value": "{{usuario}}"
              },
              {
                "key": "contrasena",
                "value": "{{password}}"
              }
            ],
            "url": "{{seguridadUrl}}/login",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"usuario\") || !pm.environment.get(\"password\")) { pm.execution.skipRequest(); throw new Error(\"Complete usuario y password en el entorno local\"); }",
                  "pm.collectionVariables.set(\"p1Run\", String(Date.now()));",
                  "const letters = Array.from({length:8}, () => String.fromCharCode(65 + Math.floor(Math.random()*26))).join(\"\"); pm.collectionVariables.set(\"parametroPrueba\", \"PM\"+letters);",
                  "pm.environment.unset(\"token\"); pm.environment.unset(\"refresh_token\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const j = pm.response.json(); pm.environment.set(\"token\", j.access_token); pm.environment.set(\"refresh_token\", j.refresh_token); }",
                  "pm.test(\"JWT y refresh emitidos\", () => { const j = pm.response.json(); pm.expect(j.access_token).to.be.a(\"string\").and.not.empty; pm.expect(j.refresh_token).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Validar JWT",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{seguridadUrl}}/validate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Token válido\", () => pm.expect(pm.response.json()).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta",
