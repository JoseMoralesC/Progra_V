                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.environment.set(\"refreshAnterior\", pm.environment.get(\"refresh_token\")); const j=pm.response.json(); pm.environment.set(\"token\",j.access_token); pm.environment.set(\"refresh_token\",j.refresh_token); }"
                ]
              }
            }
          ]
        },
