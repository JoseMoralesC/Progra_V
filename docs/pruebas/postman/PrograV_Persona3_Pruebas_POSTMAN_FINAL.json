  "item": [
    {
      "name": "00 - Seguridad",
      "item": [
        {
          "name": "P3-AUTH-01 - Login y guardar access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "usuario",
                "value": "{{loginUsuario}}",
                "type": "text"
              },
              {
                "key": "contrasena",
                "value": "{{loginContrasena}}",
                "type": "text"
              }
            ],
            "url": "{{seguridadBaseUrl}}/login",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.expect(data.access_token, 'access_token').to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('token', data.access_token);",
                  "if (data.refresh_token) pm.collectionVariables.set('refreshToken', data.refresh_token);",
                  "if (data.expires_in) pm.collectionVariables.set('tokenExpiresIn', data.expires_in);"
                ]
              }
            }
          ]
        },
        {
          "name": "P3-AUTH-02 - Validar token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{seguridadBaseUrl}}/validate",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token valido', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.expect(pm.response.json()).to.eql(true);"
                ]
              }
            }
          ]
        },
        {
          "name": "P3-AUTH-03 - Registrar bitacora",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{loginUsuario}}\",\n  \"descripcion\": \"Prueba Postman Persona 3 - validacion de bitacora\"\n}"
            },
            "url": "{{seguridadBaseUrl}}/bitacora"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Bitacora responde 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
