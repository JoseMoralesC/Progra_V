# Copie este archivo con el nombre .env y reemplace localmente los valores de ejemplo.
# Nunca agregue a Git el archivo .env resultante.

# Servidor de SQL Server accesible mediante Tailscale.
# Use el nombre MagicDNS del equipo o su direccion IP de Tailscale (100.x.x.x).
DB_HOST=servidor-sql.tailnet-ejemplo.ts.net
DB_PORT=1433
DB_NAME=NuevoAvatar_Integracion
DB_USERNAME=usuario_aplicacion_ejemplo
DB_PASSWORD=reemplazar_con_contrasena_local

# Configuracion de la conexion de Spring Boot con la base de datos.
# Mantenga la URL completa en una sola linea y actualice el servidor y la base de datos.
SPRING_DATASOURCE_URL=jdbc:sqlserver://servidor-sql.tailnet-ejemplo.ts.net:1433;databaseName=NuevoAvatar_Integracion;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=usuario_aplicacion_ejemplo
SPRING_DATASOURCE_PASSWORD=reemplazar_con_contrasena_local
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.microsoft.sqlserver.jdbc.SQLServerDriver

# El esquema de la base de datos debe administrarse mediante los scripts SQL versionados.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
