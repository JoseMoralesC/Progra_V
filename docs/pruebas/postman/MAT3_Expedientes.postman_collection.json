{
  "info": {
    "name": "Fabian - MAT3 Expedientes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion preparada; no ejecutada contra servicios reales. Requiere migraciones, token valido, DOMESTUD e IDs territoriales existentes. El flujo crea, modifica y elimina el expediente ficticio. Su ejecucion en PrograV requiere autorizacion de Fabian."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "identificacionPrueba",
      "value": "PRUEBA-MAT3-FABIAN"
    }
  ],
  "item": [
    {
      "name": "Crear, consultar y modificar",
      "item": [
        {
          "name": "P01 Crear expediente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/expediente",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificacion\": \"{{identificacionPrueba}}\",\n  \"tipoIdentificacion\": \"Cedula\",\n  \"email\": \"estudiante.prueba@cuc.cr\",\n  \"nombreCompleto\": \"Ana Maria\",\n  \"fechaNacimiento\": \"2012-05-10\",\n  \"provinciaId\": 1,\n  \"cantonId\": 2,\n  \"distritoId\": 3,\n  \"otrasSenas\": \"Casa de prueba\",\n  \"telefonos\": [\n    \"2222-3333\",\n    \"8888-9999\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
