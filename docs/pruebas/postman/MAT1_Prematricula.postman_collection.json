{
  "info": {
    "name": "Fabian - MAT1 Prematricula",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Preparada, no ejecutada contra servicios reales. Requiere estudiante y oferta academica existentes, token y periodos acordes a la fecha de ejecucion. El flujo crea y elimina su prematricula de prueba. No crea ni borra estudiantes o cursos. Su ejecucion en PrograV requiere autorizacion de Fabian."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "identificacionEstudiante",
      "value": "PRUEBA-MAT3-FABIAN"
    },
    {
      "key": "carreraId",
      "value": "1"
    },
    {
      "key": "cursoId",
      "value": "10"
    },
    {
      "key": "otroCursoId",
      "value": "11"
    },
    {
      "key": "cursoNivelDosId",
      "value": "12"
    },
    {
      "key": "periodoFuturoId",
      "value": "20"
    },
    {
      "key": "periodoHoyId",
      "value": "21"
    },
    {
      "key": "periodoPasadoId",
      "value": "22"
    },
    {
      "key": "prematriculaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Crear, consultar y modificar",
      "item": [
        {
          "name": "Crear prematricula de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/prematricula",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificacionEstudiante\": \"{{identificacionEstudiante}}\",\n  \"carreraId\": {{carreraId}},\n  \"cursos\": [\n    {{cursoId}},\n    {{otroCursoId}}\n  ],\n  \"observaciones\": \"Prematricula de prueba\",\n  \"periodoId\": {{periodoFuturoId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"prematriculaId\", pm.response.json().id); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"prematriculaId\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar todas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/prematricula"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar por llave",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/prematricula/{{prematriculaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Modificar y quitar observaciones",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/prematricula/{{prematriculaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificacionEstudiante\": \"{{identificacionEstudiante}}\",\n  \"carreraId\": {{carreraId}},\n  \"cursos\": [\n    {{cursoId}}\n  ],\n  \"observaciones\": null,\n  \"periodoId\": {{periodoFuturoId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar modificacion",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/prematricula/{{prematriculaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
